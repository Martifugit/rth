<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server itself (tick loop, world, networking, persistence). netstandard2.1 so the Unity
    Editor can host it in-process during development; Rth.Server is the standalone host.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Rth.Server</RootNamespace>
    <RthCopyToUnity>true</RthCopyToUnity>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity provides the same assembly through com.unity.nuget.newtonsoft-json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Rth.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rth.Tests" />
  </ItemGroup>

</Project>
