<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The world data from the command line, without Unity (docs/workflow.md). Run it as
    "dotnet run project tools/world" followed by check, export, render or format; help lists them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rth.WorldTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Rth.Shared.csproj" />
  </ItemGroup>

</Project>
