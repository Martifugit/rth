{
  "name": "rth-docs-editor",
  "private": true,
  "version": "0.3.0",
  "description": "The R'th Codex: the design docs of R'th, with Discord and AI built in. A tool for the team, never shipped with the game.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --sourcemap --outfile=public/app.js",
    "app": "npm run build && node electron/launch.js",
    "start": "npm run build && node server.js",
    "test": "node test/merge.test.js && node test/notes.test.js && node test/spell.test.js && node test/sync.test.js && node test/discord.test.js && node test/ai-diff.test.js && node test/openrouter.test.js && node test/ai-comments.test.js && node test/changelog.test.js && node test/gdd.test.js && node test/frontmatter.test.js",
    "notes": "node notes.js",
    "dist": "npm run build && node scripts/fetch-mingit.mjs && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "electron-updater": "^6.8.11",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-code": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-paragraph": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "markdown-it": "^14.1.0",
    "rcedit": "^5.0.2",
    "tiptap-markdown": "^0.8.10"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "rth.codex",
    "productName": "R'th Codex",
    "copyright": "",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "server.js",
      "src/**",
      "public/**",
      "assets/**",
      "package.json",
      "!public/app.js.map"
    ],
    "extraResources": [
      {
        "from": "../../client/Assets/Resources/UI",
        "to": "look/UI",
        "filter": [
          "**/*",
          "!**/*.meta"
        ]
      },
      {
        "from": "../../client/Assets/Resources/Icons",
        "to": "look/Icons",
        "filter": [
          "**/*",
          "!**/*.meta"
        ]
      },
      {
        "from": "build/mingit",
        "to": "git"
      }
    ],
    "protocols": [
      {
        "name": "R'th Codex",
        "schemes": [
          "rth-codex"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico",
      "artifactName": "RthCodexSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "R'th Codex",
      "uninstallDisplayName": "R'th Codex",
      "deleteAppDataOnUninstall": true,
      "include": "scripts/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Martifugit/rth/releases/latest/download"
      }
    ]
  }
}
