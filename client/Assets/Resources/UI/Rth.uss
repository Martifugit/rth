/*
 * R'th interface theme: dark fantasy RPG. Charcoal-brown panels inside thin bronze frames with
 * gold corner accents, Cinzel for titles, Alegreya Sans for everything you read.
 * Textures live in Resources/UI/Skin (drawn by tools/ui-skin/make_skin.py); slice sizes here
 * must match the ones noted there.
 *
 * Colour roles
 *   text    #ddd3bf   body             title   #e0c387   window titles, headings
 *   value   #f0d58c   numbers          muted   #a89c86   hints, inactive
 *
 * Text sizes: 15 body, 13 small (never smaller), 14 tooltips. Slot numbers are bold.
 *   good    #7ccf62   bad     #e0604e  accent  #c9a25e   bronze lines, focus
 */

.rth-root {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Medium");
    font-size: 15px;
    color: rgb(221, 211, 191);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.85);
}

/* ---------------------------------------------------------------- windows */

.window {
    position: absolute;
    background-color: rgb(16, 15, 13);
    border-radius: 5px;
    background-image: resource("UI/Skin/window");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    padding: 3px;
}

.window--bare {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.window__titlebar {
    flex-direction: row;
    align-items: center;
    height: 32px;
    background-image: resource("UI/Skin/title");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 0 4px 0 6px;
}

.window__title-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(224, 195, 135);
}

.window__title {
    flex-grow: 1;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(224, 195, 135);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.window__tabs {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    align-items: stretch;
}

.tab {
    width: 28px;
    margin-right: 1px;
    align-items: center;
    justify-content: center;
}

.tab:hover {
    background-color: rgba(255, 230, 180, 0.06);
}

.tab--active {
    background-image: resource("UI/Skin/tab-active");
    -unity-background-scale-mode: stretch-to-fill;
}

.tab__icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(139, 128, 108);
}

.tab:hover > .tab__icon {
    -unity-background-image-tint-color: rgb(205, 185, 143);
}

.tab--active > .tab__icon {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.window__button {
    width: 22px;
    height: 22px;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(143, 132, 113);
}

.window__button:hover {
    -unity-background-image-tint-color: rgb(240, 120, 100);
}

.window__body {
    flex-grow: 1;
    padding: 8px;
    overflow: hidden;
}

.window--bare > .window__body {
    padding: 0;
}

/* Any corner resizes: an L of bronze, shown while the pointer is over the window. */
.window__grip {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(201, 162, 94, 0);
}

.window:hover > .window__grip {
    border-color: rgba(201, 162, 94, 0.55);
}

.window__grip:hover {
    border-color: rgb(240, 213, 140);
}

.window__grip--tl { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
.window__grip--tr { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
.window__grip--bl { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
.window__grip--br { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }

/* Room to grab the title bar between the tabs and the close button. */
.window__drag-space {
    min-width: 28px;
    flex-grow: 1;
}

.window__tabs {
    flex-grow: 0;
}

.window__handle {
    position: absolute;
    left: -4px;
    top: -4px;
    width: 14px;
    height: 14px;
    background-color: rgb(201, 162, 94);
    border-width: 2px;
    border-color: rgb(14, 12, 10);
    border-radius: 7px;
    opacity: 0;
    display: none;
}

/* Only frameless windows (bars, the minimap) have a move handle; framed ones move by the title bar. */
.window--bare > .window__handle {
    display: flex;
}

.window--bare:hover > .window__handle {
    opacity: 1;
}

.window--fixed > .window__grip,
.window--bare > .window__grip {
    display: none;
}

/* Locked: nothing moves, resizes or closes. */
.rth-root--locked .window__grip,
.rth-root--locked .window__handle,
.rth-root--locked .window__close {
    display: none;
}

/* Floating windows (bank, shop, conversation) sit above the HUD: a deeper shadow sets them apart. */
.window--floating {
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

/* The window a dragged tab will join. */
.window--dock-target {
    border-width: 2px;
    border-color: rgb(240, 213, 140);
}

/* Where a window being moved or resized will land, and the lines it lines up with. */
.landing {
    position: absolute;
    border-width: 2px;
    border-color: rgba(240, 213, 140, 0.9);
    background-color: rgba(240, 213, 140, 0.08);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

/* Where a dragged tab will go in a tab strip. */
.landing--marker {
    border-width: 0;
    background-color: rgb(240, 213, 140);
    border-radius: 2px;
}

.landing--blocked {
    border-color: rgba(224, 96, 78, 0.9);
    background-color: rgba(224, 96, 78, 0.08);
}

.landing__label {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(240, 213, 140);
    background-color: rgba(12, 10, 9, 0.85);
    padding: 3px 8px;
    border-radius: 3px;
}

.guide {
    position: absolute;
    background-color: rgba(240, 213, 140, 0.5);
}

/* A panel's content scrolls inside its window rather than spilling or squashing. */
.panel-scroll {
    flex-grow: 1;
}

.panel-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
}

/* Hints and help text wrap instead of running off the edge. */
.window__body .muted,
.window__body .small {
    white-space: normal;
}

/* The interface lock on the main action bar. */
.hud__lock {
    position: absolute;
    right: 7px;
    top: 7px;
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(168, 156, 134, 0.55);
}

.hud__lock:hover {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.hud__lock--on {
    -unity-background-image-tint-color: rgb(224, 195, 135);
}

/* The interface menu (the button under the minimap). */
.windows-menu {
    min-width: 250px;
    background-color: rgba(12, 10, 9, 0.97);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 4px;
    padding: 4px 0 6px 0;
}

.windows-menu__title {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    padding: 4px 12px 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.3);
}

.windows-menu__section {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(143, 132, 113);
    padding: 8px 12px 2px 12px;
}

.windows-menu__row {
    flex-direction: row;
    align-items: center;
    padding: 3px 12px;
}

.windows-menu__row:hover {
    background-color: rgba(224, 195, 135, 0.12);
}

.windows-menu__icon {
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(139, 128, 108);
}

.windows-menu__row--open > .windows-menu__icon {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.windows-menu__name {
    flex-grow: 1;
    color: rgb(168, 156, 134);
}

.windows-menu__row--open > .windows-menu__name {
    color: rgb(221, 211, 191);
}

.windows-menu__key {
    font-size: 13px;
    color: rgb(143, 132, 113);
    margin-right: 10px;
}

.windows-menu__state {
    font-size: 13px;
    width: 50px;
    -unity-text-align: middle-right;
    color: rgb(143, 132, 113);
}

.windows-menu__row--open > .windows-menu__state {
    color: rgb(124, 207, 98);
}

.windows-menu__footer {
    flex-direction: row;
    margin: 8px 12px 0 12px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(201, 162, 94, 0.3);
}

/* ---------------------------------------------------------------- modal windows */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.modal {
    background-color: rgb(16, 15, 13);
    border-radius: 5px;
    background-image: resource("UI/Skin/window");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    padding: 3px;
}

.modal__tabs {
    flex-direction: row;
    padding: 0 10px;
    height: 38px;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.35);
}

.modal-tab {
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    margin-right: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.modal-tab:hover {
    background-color: rgba(255, 230, 180, 0.05);
}

.modal-tab--active {
    border-bottom-color: rgb(224, 195, 135);
    background-color: rgba(224, 195, 135, 0.08);
}

.modal-tab__icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(143, 132, 113);
}

.modal-tab--active > .modal-tab__icon {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.modal-tab__label {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(143, 132, 113);
}

.modal-tab--active > .modal-tab__label {
    color: rgb(240, 213, 140);
}

.modal__body {
    flex-grow: 1;
    padding: 12px 14px;
}

/* Master-detail inside a modal: a list on the left, the selected thing on the right. */
.master {
    width: 230px;
    margin-right: 12px;
}

.master-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-radius: 2px;
}

.master-row:hover {
    background-color: rgba(255, 230, 180, 0.06);
}

.master-row--selected {
    background-color: rgba(224, 195, 135, 0.14);
}

.detail {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- surfaces */

.hud {
    background-color: rgba(13, 12, 10, 0.94);
    border-radius: 4px;
    background-image: resource("UI/Skin/hud");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    padding: 8px 10px;
}

.card {
    background-image: resource("UI/Skin/card");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    padding: 8px;
}

.well {
    background-color: rgba(6, 5, 4, 0.55);
    border-width: 1px;
    border-color: rgb(42, 37, 31);
    border-radius: 3px;
    padding: 4px;
}

.divider {
    height: 9px;
    margin: 6px 0;
    background-image: resource("UI/Skin/divider");
    -unity-background-scale-mode: stretch-to-fill;
}

.rule {
    height: 1px;
    margin: 6px 0;
    background-color: rgba(201, 162, 94, 0.3);
}

/* A row pinned under a panel's content (skills' total level), set off by a faint line. */
.footer-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 6px 4px 0 4px;
    border-top-width: 1px;
    border-top-color: rgba(201, 162, 94, 0.2);
}

/* ---------------------------------------------------------------- text */

.heading {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    margin: 4px 0 4px 0;
}

.title-large {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(240, 213, 140);
}

.value {
    color: rgb(240, 213, 140);
}

.muted {
    color: rgb(168, 156, 134);
}

.good {
    color: rgb(124, 207, 98);
}

.bad {
    color: rgb(224, 96, 78);
}

.small {
    font-size: 13px;
}

.bold {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
}

.nowrap {
    white-space: nowrap;
}

.prose {
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

.icon {
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- tooltip and menu */

.tooltip {
    position: absolute;
    max-width: 340px;
    padding: 8px 10px;
    background-color: rgba(12, 10, 9, 0.97);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
    white-space: normal;
    font-size: 14px;
}

.drag-ghost {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(12, 10, 9, 0.9);
    border-width: 1px;
    border-color: rgb(201, 162, 94);
    border-radius: 3px;
}

.menu {
    min-width: 170px;
    background-color: rgba(12, 10, 9, 0.97);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
    padding-bottom: 3px;
}

.menu__title {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    padding: 5px 10px 4px 10px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.3);
}

.menu__option {
    padding: 3px 10px;
}

.menu__option:hover {
    background-color: rgba(224, 195, 135, 0.16);
    color: rgb(255, 240, 200);
}

.hover-text {
    position: absolute;
    left: 10px;
    top: 6px;
    font-size: 15px;
    color: rgb(240, 232, 214);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

/* ---------------------------------------------------------------- bars */

.bar {
    height: 18px;
    flex-grow: 1;
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
    overflow: hidden;
}

.bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.bar__gloss {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("UI/Skin/gloss");
    -unity-background-scale-mode: stretch-to-fill;
}

.bar__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

.bar-row {
    flex-direction: row;
    align-items: center;
}

.bar-row__icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------------------------------------------------------- buttons and inputs */

.button {
    padding: 4px 12px;
    margin: 2px;
    background-image: resource("UI/Skin/button");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 14px;
    color: rgb(240, 222, 176);
    -unity-text-align: middle-center;
}

.button:hover {
    background-image: resource("UI/Skin/button-hover");
}

.button--on {
    background-image: resource("UI/Skin/button-on");
    color: rgb(255, 245, 215);
}

.button--icon {
    padding: 3px;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
}

.check {
    flex-direction: row;
    align-items: center;
    padding: 4px 2px;
}

.check:hover {
    background-color: rgba(255, 230, 180, 0.05);
}

.check__box {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
}

.check--on > .check__box {
    background-color: rgb(201, 162, 94);
    border-color: rgb(240, 213, 140);
}

.input > .unity-text-field__input {
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
    color: rgb(240, 232, 214);
    padding: 2px 6px;
    font-size: 15px;
    --unity-cursor-color: rgb(240, 222, 176);
}

.input:focus > .unity-text-field__input {
    border-color: rgb(201, 162, 94);
}

/* ---------------------------------------------------------------- slots */

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 40px;
    height: 40px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    background-image: resource("UI/Skin/slot");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    border-width: 1px;
    border-color: rgb(74, 64, 50);
    border-top-color: rgb(40, 35, 28);
    border-radius: 3px;
}

.slot:hover {
    border-color: rgba(201, 162, 94, 0.85);
}

.slot--bare {
    background-image: none;
}

.slot__icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__count {
    position: absolute;
    left: 1px;
    top: -2px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(245, 220, 140);
    text-shadow: 0 1px 1px rgb(0, 0, 0);
}

.slot__badge {
    position: absolute;
    right: 2px;
    top: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 12px;
    color: rgb(240, 213, 140);
}

.slot__level {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(240, 110, 90);
    text-shadow: 0 1px 1px rgb(0, 0, 0);
}

.slot--dragging > .slot__icon {
    opacity: 0.3;
}

.slot--empty > .slot__icon {
    opacity: 0.22;
}

/* ---------------------------------------------------------------- buff and debuff bars */

.status {
    margin: 0 3px 0 0;
}

.status--buff {
    border-color: rgb(96, 128, 70);
    border-top-color: rgb(60, 82, 44);
}

.status--debuff {
    border-color: rgb(140, 58, 46);
    border-top-color: rgb(92, 38, 30);
}

.status__value {
    position: absolute;
    right: 1px;
    bottom: -3px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 12px;
    color: rgb(240, 225, 190);
    text-shadow: 0 1px 1px rgb(0, 0, 0);
    padding: 0;
    margin: 0;
}

.slot--locked > .slot__icon {
    opacity: 0.3;
}

.slot--on {
    border-color: rgb(240, 213, 140);
    background-color: rgba(224, 195, 135, 0.18);
}

.slot--drop {
    border-color: rgb(124, 207, 98);
}

.slot-caption {
    width: 52px;
    font-size: 13px;
    -unity-text-align: upper-center;
    white-space: normal;
}

/* ---------------------------------------------------------------- action bars */

.ability {
    width: 42px;
    height: 42px;
    margin: 0 1px;
}

.ability__key {
    position: absolute;
    right: 0;
    bottom: -3px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 15px;
    color: rgb(255, 214, 72);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 1px 1px 1px rgb(0, 0, 0);
}

.ability--queued {
    border-color: rgb(255, 180, 60);
}

/* Used out of range: held until the player reaches the target. */
.ability--stalled {
    border-color: rgb(120, 200, 255);
}

/* The global cooldown has ended: a brief flash says "act now". */
.ability {
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

.ability--ready {
    border-color: rgb(255, 236, 170);
    background-color: rgba(255, 236, 170, 0.12);
    transition-duration: 0s;
}

.ability--unusable > .slot__icon {
    /* Blended in linear space: this reads as about a quarter of full brightness. */
    opacity: 0.06;
}

.ability__timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

.chip {
    padding: 0 6px;
    margin: 0 3px;
    font-size: 13px;
}

.bile-value {
    position: absolute;
    left: 0;
    right: 0;
    /* Alegreya's digits sit low in their line box; lift them 1px to centre them on the bar. */
    top: -1px;
    bottom: 1px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 12px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* The bile axis's centre: a black stretch of the bar itself, wide enough for "+100", the value on it. */
.bile-centre {
    /* The bar's own top and bottom edges run across it; the black sits between them. */
    height: 14px;
    align-self: center;
    background-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(58, 51, 42);
}

.bile-half--left {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right-width: 0;
}

.bile-half--right {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left-width: 0;
}

/* ---------------------------------------------------------------- chat */

.chat-line {
    white-space: normal;
    font-size: 15px;
    margin: 0;
    padding: 0 2px;
    margin-bottom: 1px;
}

.chat-line--warning {
    color: rgb(240, 140, 100);
}

.chat-line--ferryman {
    color: rgb(200, 170, 255);
}

/* The filter tabs: a slim row of their own over the text, with a faint line under it from edge to edge. */
.chat-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 17px;
    align-items: stretch;
    /* Out over the window body's padding, so the line under it runs to the frame on both sides. */
    margin: -6px -8px 2px -8px;
    padding: 0 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.18);
}

.chat-tab {
    padding: 0 7px;
    margin: 0 1px 0 0;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(168, 156, 134);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: -1px;
}

.chat-tab:hover {
    color: rgb(205, 185, 143);
}

.chat-tab--on {
    color: rgb(240, 213, 140);
    border-bottom-color: rgb(224, 195, 135);
}

.chat-input-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
    height: 22px;
    /* Out over the window body's padding, like the tab row: the line above runs frame to frame. */
    margin: 2px -8px -6px -8px;
    padding: 0 8px;
    border-top-width: 1px;
    border-top-color: rgba(201, 162, 94, 0.18);
}

.chat-input {
    flex-grow: 1;
    margin: 0 0 0 4px;
    padding: 0;
}

.chat-name {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.chat-hint {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.chat-input > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(150, 200, 255);
    font-size: 15px;
    padding: 0;
    margin: 0;
    flex-grow: 1;
    -unity-text-align: middle-left;
    --unity-cursor-color: rgb(240, 222, 176);
    --unity-selection-color: rgba(150, 200, 255, 0.3);
}

/* ---------------------------------------------------------------- minimap */
/* A round map in a bronze bezel (Skin/minimap-bezel: ring, crest, medallions and the cradle the
   round buttons sit on). MinimapPanel.cs places everything; its geometry matches make_skin.py. */

.minimap-frame {
    width: 240px;
    height: 240px;
}

/* The map is clipped to a circle: the round border radius with overflow hidden masks its children. */
.minimap {
    border-radius: 88px;
    overflow: hidden;
    background-color: rgb(10, 10, 10);
}

.minimap__view,
.minimap__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.minimap__bezel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: resource("UI/Skin/minimap-bezel");
    -unity-background-scale-mode: stretch-to-fill;
}

.minimap__dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
}

.minimap__you {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255, 255, 255);
}

/* The region's name, low on the map where the ring's shadow keeps it readable. */
.minimap__region {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 24px;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 1px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: rgb(240, 222, 176);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

/* The compass and the clock sit in the bezel's two medallions; a gold ring lights on hover. */
.minimap__medal {
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.minimap__medal:hover {
    border-color: rgb(224, 195, 135);
}

.minimap__clock {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(240, 213, 140);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* Round buttons in the cradle (Skin/orb, orb-hover, orb-on). */
.orb {
    align-items: center;
    justify-content: center;
    background-image: resource("UI/Skin/orb");
    -unity-background-scale-mode: stretch-to-fill;
}

.orb:hover {
    background-image: resource("UI/Skin/orb-hover");
}

.orb:hover > .orb__icon {
    -unity-background-image-tint-color: rgb(250, 230, 180);
}

.orb__icon {
    -unity-background-image-tint-color: rgb(205, 185, 143);
}

.orb--on {
    background-image: resource("UI/Skin/orb-on");
}

.orb--on > .orb__icon {
    -unity-background-image-tint-color: rgb(200, 245, 170);
}

/* ---------------------------------------------------------------- guide: skill unlocks */
/* One list in level order: icon, level, name, a badge for the kind. Chips over it narrow it to a
   kind; a line marks the player's level. */

.guide-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.guide-chip {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    margin: 0 6px 4px 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 162, 94, 0.3);
    background-color: rgba(0, 0, 0, 0.25);
}

.guide-chip:hover {
    border-color: rgba(224, 195, 135, 0.7);
}

.guide-chip--on {
    border-color: rgb(224, 195, 135);
    background-color: rgba(201, 162, 94, 0.2);
}

.guide-chip__text {
    font-size: 13px;
    color: rgb(205, 190, 160);
    padding: 0;
    margin: 0;
}

.guide-chip--on > .guide-chip__text {
    color: rgb(240, 213, 140);
}

.guide-chip__count {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(168, 156, 134);
    padding: 0;
    margin: 0 0 0 6px;
}

.guide-unlock {
    align-items: center;
    padding: 3px 8px 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.07);
}

.guide-unlock:hover {
    background-color: rgba(255, 240, 210, 0.03);
}

.guide-unlock__slot {
    width: 32px;
    height: 32px;
}

.guide-unlock__level {
    width: 36px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    -unity-text-align: middle-center;
    color: rgb(124, 207, 98);
}

.guide-unlock__name {
    white-space: normal;
}

.guide-unlock--locked .slot__icon {
    opacity: 0.45;
}

.guide-unlock--locked > .guide-unlock__level,
.guide-unlock--locked > .guide-unlock__name {
    color: rgb(143, 132, 113);
}

/* The kind, small and quiet: a word in the kind's colour on a faint wash of it. */
.guide-badge {
    flex-shrink: 0;
    font-size: 13px;
    padding: 0 7px;
    margin: 0 0 0 8px;
    border-radius: 3px;
    border-width: 1px;
}

.guide-badge--abilities {
    color: rgb(226, 150, 120);
    border-color: rgba(226, 150, 120, 0.3);
    background-color: rgba(226, 150, 120, 0.08);
}

.guide-badge--equipment {
    color: rgb(160, 182, 214);
    border-color: rgba(160, 182, 214, 0.3);
    background-color: rgba(160, 182, 214, 0.08);
}

.guide-badge--recipes {
    color: rgb(150, 205, 128);
    border-color: rgba(150, 205, 128, 0.3);
    background-color: rgba(150, 205, 128, 0.08);
}

.guide-badge--gathering {
    color: rgb(224, 195, 135);
    border-color: rgba(224, 195, 135, 0.3);
    background-color: rgba(224, 195, 135, 0.08);
}

/* "Your level: 12" between what you have and what comes next. */
.guide-yours {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
}

.guide-yours__rule {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(224, 195, 135, 0.45);
}

.guide-yours__text {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    margin: 0 8px;
    padding: 0;
}

/* ---------------------------------------------------------------- scrollbars: thin and quiet */

.rth-root .unity-scroller--vertical,
.rth-root .unity-scroll-view__vertical-scroller {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.rth-root .unity-scroller--vertical > .unity-scroller__low-button,
.rth-root .unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.rth-root .unity-scroller--vertical > .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
    top: 0;
    bottom: 0;
}

.rth-root .unity-scroller--vertical .unity-base-slider__drag-container {
    width: 6px;
    min-width: 6px;
}

.rth-root .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    border-radius: 3px;
    left: 1px;
    right: 1px;
    width: auto;
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(201, 162, 94, 0.5);
    border-width: 0;
    border-radius: 3px;
    left: 0;
    right: 0;
    width: auto;
    min-width: 0;
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(224, 195, 135, 0.85);
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

.rth-root .unity-scroller--horizontal {
    display: none;
}

/* ---------------------------------------------------------------- XP drops (XpDropsPanel) */
/* No surface: only the numbers, an icon and a soft shadow so they read over the world.
   Position, fade and scale are set per frame in code; nothing here catches the pointer. */

.xpdrops {
    flex-grow: 1;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 162, 94, 0);
}

/* Only while the move handle is under the pointer: a faint outline shows how far the piece reaches. */
.window--bare:hover .xpdrops {
    border-color: rgba(201, 162, 94, 0.3);
}

.xpdrop {
    position: absolute;
    right: 4px;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    height: 22px;
    transform-origin: right;
}

.xpdrop__icon-box {
    width: 18px;
    height: 18px;
    margin-right: 4px;
}

.xpdrop__icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

.xpdrop__icon--shadow {
    left: 1px;
    top: 1px;
}

.xpdrop__amount {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 17px;
    color: rgb(240, 213, 140);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
    padding: 0;
    margin: 0;
}

.xpdrop__level {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
    margin: 0 6px 0 0;
    padding: 0;
}

/* A level gained: a touch larger and brighter, with a warm glow. */
.xpdrop--level {
    height: 26px;
}

.xpdrop--level .xpdrop__amount {
    font-size: 19px;
    color: rgb(255, 232, 160);
    text-shadow: 0 0 6px rgba(240, 190, 90, 0.75);
/* ---------------------------------------------------------------- U2: worn buttons, character window, inspect */

/* The row of buttons under the worn equipment figure. */
.worn__buttons {
    justify-content: center;
    height: 40px;
}

.worn__buttons > .button--icon {
    margin: 0 3px;
}

.character-columns {
    flex-direction: row;
    align-items: flex-start;
}

.character-column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.character-card {
    margin-bottom: 10px;
}

/* A label on the left, numbers in fixed-width cells on the right (stats, the per-style table, highlights). */
.stat-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
}

.stat-row__label {
    flex-grow: 1;
    flex-shrink: 1;
}

.stat-cell {
    width: 72px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.stat-cell--zero {
    color: rgb(143, 132, 113);
}

.inspect-head {
    margin-bottom: 8px;
}

.inspect-head__who {
    flex-grow: 1;
    margin-left: 12px;
}

.inspect-note {
    margin: 0 4px 8px 4px;
}

.inspect-body {
    flex-direction: row;
    align-items: flex-start;
}

.inspect-figure {
    padding: 8px 14px;
    margin-right: 16px;
}

.inspect-side {
    flex-grow: 1;
}

.inspect-line__icon {
    margin-right: 8px;
}
/* ---------------------------------------------------------------- bestiary (U2) */

/* The bestiary's own tabs (Bosses, then regions): filter tabs on a row that wraps, a faint line under it. */
.bestiary-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.18);
}

/* A hint at a notable drop: the slot, its rarity word under it. */
.bestiary-hint {
    width: 64px;
    margin: 0 4px 6px 0;
    align-items: center;
}

.bestiary-hint--unique > .slot {
    border-color: rgba(224, 195, 135, 0.8);
}

/* Not had yet: a silhouette (tinted in code) under a question mark. */
.bestiary-hint__slot--unknown {
    background-color: rgba(0, 0, 0, 0.55);
}

.bestiary-hint__mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(168, 156, 134);
}

.bestiary-hint__caption {
    font-size: 13px;
    margin: 1px 0 0 0;
    padding: 0;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.bestiary-carcass {
    margin-top: 4px;
    align-items: center;
}

.bestiary-carcass__slot {
    margin: 0 10px 0 0;
    flex-shrink: 0;
}

.bestiary-carcass__text {
    flex-grow: 1;
    flex-shrink: 1;
}
