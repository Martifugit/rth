/*
 * R'th interface theme: dark fantasy RPG. Charcoal-brown panels inside thin bronze frames with
 * gold corner accents, Cinzel for titles, Alegreya Sans for everything you read.
 * Textures live in Resources/UI/Skin (drawn by tools/ui-skin/make_skin.py); slice sizes here
 * must match the ones noted there.
 *
 * Colour roles
 *   text    #ddd3bf   body             title   #e0c387   window titles, headings
 *   value   #f0d58c   numbers          muted   #8f8471   hints, inactive
 *   good    #7ccf62   bad     #e0604e  accent  #c9a25e   bronze lines, focus
 */

.rth-root {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Medium");
    font-size: 14px;
    color: rgb(221, 211, 191);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.85);
}

/* ---------------------------------------------------------------- windows */

.window {
    position: absolute;
    background-color: rgb(16, 15, 13);
    border-radius: 5px;
    background-image: resource("UI/Skin/window");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    padding: 3px;
}

.window--bare {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.window__titlebar {
    flex-direction: row;
    align-items: center;
    height: 32px;
    background-image: resource("UI/Skin/title");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 0 4px 0 6px;
}

.window__title-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(224, 195, 135);
}

.window__title {
    flex-grow: 1;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(224, 195, 135);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.window__tabs {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    align-items: stretch;
}

.tab {
    width: 28px;
    margin-right: 1px;
    align-items: center;
    justify-content: center;
}

.tab:hover {
    background-color: rgba(255, 230, 180, 0.06);
}

.tab--active {
    background-image: resource("UI/Skin/tab-active");
    -unity-background-scale-mode: stretch-to-fill;
}

.tab__icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(139, 128, 108);
}

.tab:hover > .tab__icon {
    -unity-background-image-tint-color: rgb(205, 185, 143);
}

.tab--active > .tab__icon {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.window__button {
    width: 22px;
    height: 22px;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(143, 132, 113);
}

.window__button:hover {
    -unity-background-image-tint-color: rgb(240, 120, 100);
}

.window__header {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(224, 195, 135);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin: 2px 0 6px 0;
}

.window__body {
    flex-grow: 1;
    padding: 8px;
    overflow: hidden;
}

.window--bare > .window__body {
    padding: 0;
}

.window__grip {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 10px;
    height: 10px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(201, 162, 94, 0.6);
}

.window__handle {
    position: absolute;
    left: -4px;
    top: -4px;
    width: 14px;
    height: 14px;
    background-color: rgb(201, 162, 94);
    border-width: 2px;
    border-color: rgb(14, 12, 10);
    border-radius: 7px;
    opacity: 0;
}

.window--bare:hover > .window__handle {
    opacity: 1;
}

.window--fixed > .window__grip {
    display: none;
}

.rth-root--locked .window__grip,
.rth-root--locked .window__handle {
    display: none;
}

/* ---------------------------------------------------------------- modal windows */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.modal {
    background-color: rgb(16, 15, 13);
    border-radius: 5px;
    background-image: resource("UI/Skin/window");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    padding: 3px;
}

.modal__tabs {
    flex-direction: row;
    padding: 0 10px;
    height: 38px;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.35);
}

.modal-tab {
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    margin-right: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.modal-tab:hover {
    background-color: rgba(255, 230, 180, 0.05);
}

.modal-tab--active {
    border-bottom-color: rgb(224, 195, 135);
    background-color: rgba(224, 195, 135, 0.08);
}

.modal-tab__icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(143, 132, 113);
}

.modal-tab--active > .modal-tab__icon {
    -unity-background-image-tint-color: rgb(240, 213, 140);
}

.modal-tab__label {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(143, 132, 113);
}

.modal-tab--active > .modal-tab__label {
    color: rgb(240, 213, 140);
}

.modal__body {
    flex-grow: 1;
    padding: 12px 14px;
}

/* Master-detail inside a modal: a list on the left, the selected thing on the right. */
.master {
    width: 230px;
    margin-right: 12px;
}

.master-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-radius: 2px;
}

.master-row:hover {
    background-color: rgba(255, 230, 180, 0.06);
}

.master-row--selected {
    background-color: rgba(224, 195, 135, 0.14);
}

.detail {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- surfaces */

.hud {
    background-color: rgba(13, 12, 10, 0.94);
    border-radius: 4px;
    background-image: resource("UI/Skin/hud");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    padding: 8px 10px;
}

.card {
    background-image: resource("UI/Skin/card");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    padding: 8px;
}

.well {
    background-color: rgba(6, 5, 4, 0.55);
    border-width: 1px;
    border-color: rgb(42, 37, 31);
    border-radius: 3px;
    padding: 4px;
}

.divider {
    height: 9px;
    margin: 6px 0;
    background-image: resource("UI/Skin/divider");
    -unity-background-scale-mode: stretch-to-fill;
}

.rule {
    height: 1px;
    margin: 6px 0;
    background-color: rgba(201, 162, 94, 0.3);
}

/* ---------------------------------------------------------------- text */

.heading {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    margin: 4px 0 4px 0;
}

.title-large {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(240, 213, 140);
}

.value {
    color: rgb(240, 213, 140);
}

.muted {
    color: rgb(143, 132, 113);
}

.good {
    color: rgb(124, 207, 98);
}

.bad {
    color: rgb(224, 96, 78);
}

.small {
    font-size: 12px;
}

.bold {
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
}

.prose {
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

.icon {
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- tooltip and menu */

.tooltip {
    position: absolute;
    max-width: 320px;
    padding: 8px 10px;
    background-color: rgba(12, 10, 9, 0.97);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
    white-space: normal;
    font-size: 13px;
}

.drag-ghost {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(12, 10, 9, 0.9);
    border-width: 1px;
    border-color: rgb(201, 162, 94);
    border-radius: 3px;
}

.menu {
    min-width: 170px;
    background-color: rgba(12, 10, 9, 0.97);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
    padding-bottom: 3px;
}

.menu__title {
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(224, 195, 135);
    padding: 5px 10px 4px 10px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 162, 94, 0.3);
}

.menu__option {
    padding: 3px 10px;
}

.menu__option:hover {
    background-color: rgba(224, 195, 135, 0.16);
    color: rgb(255, 240, 200);
}

.hover-text {
    position: absolute;
    left: 10px;
    top: 6px;
    font-size: 15px;
    color: rgb(240, 232, 214);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

/* ---------------------------------------------------------------- bars */

.bar {
    height: 18px;
    flex-grow: 1;
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
    overflow: hidden;
}

.bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.bar__gloss {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("UI/Skin/gloss");
    -unity-background-scale-mode: stretch-to-fill;
}

.bar__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 12px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgb(0, 0, 0);
}

.bar-row {
    flex-direction: row;
    align-items: center;
}

.bar-row__icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------------------------------------------------------- buttons and inputs */

.button {
    padding: 4px 12px;
    margin: 2px;
    background-image: resource("UI/Skin/button");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(240, 222, 176);
    -unity-text-align: middle-center;
}

.button:hover {
    background-image: resource("UI/Skin/button-hover");
}

.button--on {
    background-image: resource("UI/Skin/button-on");
    color: rgb(255, 245, 215);
}

.button--icon {
    padding: 3px;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
}

.check {
    flex-direction: row;
    align-items: center;
    padding: 4px 2px;
}

.check:hover {
    background-color: rgba(255, 230, 180, 0.05);
}

.check__box {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    border-radius: 3px;
}

.check--on > .check__box {
    background-color: rgb(201, 162, 94);
    border-color: rgb(240, 213, 140);
}

.input > .unity-text-field__input {
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
    color: rgb(240, 232, 214);
    padding: 2px 6px;
    font-size: 14px;
}

.input:focus > .unity-text-field__input {
    border-color: rgb(201, 162, 94);
}

/* ---------------------------------------------------------------- slots */

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 40px;
    height: 40px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-image: resource("UI/Skin/slot");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
}

.slot:hover {
    border-color: rgba(201, 162, 94, 0.8);
}

.slot--bare {
    background-image: none;
}

.slot__icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__count {
    position: absolute;
    left: 2px;
    top: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 12px;
    color: rgb(240, 213, 140);
    text-shadow: 0 1px 1px rgb(0, 0, 0);
}

.slot__badge {
    position: absolute;
    right: 2px;
    top: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 11px;
    color: rgb(240, 213, 140);
}

.slot__level {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(224, 96, 78);
}

.slot--dragging > .slot__icon {
    opacity: 0.3;
}

.slot--empty > .slot__icon {
    opacity: 0.22;
}

.slot--locked > .slot__icon {
    opacity: 0.3;
}

.slot--on {
    border-color: rgb(240, 213, 140);
    background-color: rgba(224, 195, 135, 0.18);
}

.slot--drop {
    border-color: rgb(124, 207, 98);
}

.slot-caption {
    width: 46px;
    font-size: 11px;
    -unity-text-align: upper-center;
    white-space: normal;
}

/* ---------------------------------------------------------------- action bars */

.ability {
    width: 42px;
    height: 42px;
    margin: 0 1px;
}

.ability__key {
    position: absolute;
    right: 3px;
    bottom: 0;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 11px;
    color: rgb(221, 211, 191);
}

.ability--queued {
    border-color: rgb(255, 180, 60);
}

.ability--unusable > .slot__icon {
    opacity: 0.3;
}

.ability__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 3px;
}

.ability__timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 16px;
    color: rgb(255, 255, 255);
}

.chip {
    padding: 0 6px;
    margin: 0 3px;
    font-size: 12px;
}

.bile-value {
    width: 40px;
    margin-left: 6px;
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    -unity-text-align: middle-center;
    background-color: rgb(9, 8, 7);
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
}

/* ---------------------------------------------------------------- chat */

.chat-line {
    white-space: normal;
    font-size: 14px;
}

.chat-line--warning {
    color: rgb(240, 140, 100);
}

.chat-line--assayer {
    color: rgb(200, 170, 255);
}

.chat-tab {
    padding: 2px 12px;
    margin-right: 2px;
    -unity-font-definition: resource("UI/Fonts/Cinzel");
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(143, 132, 113);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.chat-tab:hover {
    color: rgb(205, 185, 143);
}

.chat-tab--on {
    color: rgb(240, 213, 140);
    border-bottom-color: rgb(224, 195, 135);
}

.chat-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(201, 162, 94, 0.3);
}

.chat-input {
    flex-grow: 1;
    margin: 0;
}

.chat-input > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(150, 200, 255);
    font-size: 14px;
    padding: 1px 4px;
}

/* ---------------------------------------------------------------- minimap */

.minimap {
    border-width: 1px;
    border-color: rgb(58, 51, 42);
    border-radius: 3px;
    overflow: hidden;
    background-color: rgb(10, 10, 10);
}

.minimap__dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
}

.minimap__compass {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(12, 10, 9, 0.8);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    align-items: center;
    justify-content: center;
}

.minimap__clock {
    position: absolute;
    right: 6px;
    top: 6px;
    padding: 1px 8px;
    border-radius: 3px;
    background-color: rgba(12, 10, 9, 0.8);
    border-width: 1px;
    border-color: rgb(110, 90, 58);
    -unity-font-definition: resource("UI/Fonts/AlegreyaSans-Bold");
    font-size: 13px;
    color: rgb(240, 213, 140);
}

.run-gauge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin: 2px;
    background-image: resource("UI/Skin/button");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
}

.run-gauge:hover {
    background-image: resource("UI/Skin/button-hover");
}

.run-gauge--on {
    background-image: resource("UI/Skin/button-on");
}

/* ---------------------------------------------------------------- scrollbars: slim and quiet */

.rth-root .unity-scroller--vertical {
    width: 8px;
    margin-left: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.rth-root .unity-scroller--vertical > .unity-scroller__low-button,
.rth-root .unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.rth-root .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
    top: 0;
    bottom: 0;
}

.rth-root .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 4px;
    left: 2px;
    right: 2px;
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(201, 162, 94, 0.55);
    border-width: 0;
    border-radius: 4px;
    left: 1px;
    right: 1px;
    width: auto;
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(224, 195, 135, 0.85);
}

.rth-root .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

.rth-root .unity-scroller--horizontal {
    display: none;
}
