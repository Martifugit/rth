* text=auto

# Unity serialises scenes, prefabs and settings as YAML; merge them as text, never re-normalise oddly.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf

# Binary data
*.rthmap binary
*.png binary
*.fbx binary

# Generated by tools/world and Sync World with "\n" line ends; byte-compared by `tools/world check`.
server/data/maps/*.json text eol=lf
server/data/maps/*.rthmap binary
world/**/*.json text eol=lf
