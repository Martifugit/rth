# .NET build output (UseArtifactsOutput puts it all here)
/artifacts/
bin/
obj/
*.user
.vs/
.idea/

# Server runtime data
/server/saves/

# Unity
/client/[Ll]ibrary/
/client/[Tt]emp/
/client/[Oo]bj/
/client/[Bb]uild/
/client/[Bb]uilds/
/client/[Ll]ogs/
/client/[Uu]ser[Ss]ettings/
/client/MemoryCaptures/
/client/*.csproj
/client/*.sln
/client/*.slnx
/client/.vsconfig
/client/Assets/Plugins/Rth/
/client/Assets/Plugins/Rth.meta
# The generated land's scenes: Sync World builds them from world/regions on each machine.
# A region taken over moves its scene to its area's folder (tools/world check warns).
/client/Assets/Scenes/Land/
/client/Assets/Scenes/Land.meta

/client/.vscode/


# Built by tools/character-models/build_humanoid.py (regenerate rather than commit)
tools/character-models/HumanMale.blend
tools/character-models/HumanFemale.blend
*.blend1

# Python
__pycache__/

# World renders (tools/world render): regenerate rather than commit
/world/renders/

# Reference screenshots of Jagex games: kept locally, never committed
/images/osrs-*
/images/rs3-*

# Character-model experiments (logs, test exports)
tools/character-models/experiments/

# Enlarged copies of the nature textures, for looking at (tools/art/blender/textures/nature.py --preview)
tools/art/blender/textures/*/*.preview.png

# Art families' working files, rebuilt by their scripts (docs/assets.md section 10)
tools/art/blender/**/*.blend
